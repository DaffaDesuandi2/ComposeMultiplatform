CREATE TABLE noteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0
);

getAllNotes:
SELECT * FROM noteEntity ORDER BY createdAt DESC;

searchNotes:
SELECT * FROM noteEntity
WHERE title LIKE ('%' || :query || '%')
OR content LIKE ('%' || :query || '%');

-- Pakai INSERT INTO (id bisa diisi null untuk auto-increment)
insertNote:
INSERT INTO noteEntity(id, title, content, createdAt, isFavorite)
VALUES (?, ?, ?, ?, ?);

-- Tambahkan updateNote (Poin 2 Tugas: CRUD)
updateNote:
UPDATE noteEntity
SET title = ?, content = ?
WHERE id = ?;

-- Sesuaikan nama biar enak dipanggil
deleteNote:
DELETE FROM noteEntity WHERE id = ?;